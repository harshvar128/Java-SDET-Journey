package Arrays;

public class CountOcc {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		int[] arr1= {3,4,3,2,3,4};
		
		for(int i=0;i<arr1.length;i++) {
			boolean isFound=false;
			int count=0;
			for(int j=0;j<arr1.length;j++) {
				if(arr1[i]==arr1[j]) {
					count++;
				}
			}
			for(int k =0;k<i;k++) {
				if(arr1[k]==arr1[i]) {
					isFound=true;
					break;
				}
			
			}
			if(!isFound) {
				System.out.println(arr1[i] + " comes "+ count + " times.");
			}
		}
		

	}
	
}
